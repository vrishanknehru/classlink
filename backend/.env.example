# Copy to .env for local development. Never commit the real file.
CLASSLINK_ENVIRONMENT=development

# Supabase Postgres connection string (use the pooled "service" connection,
# server side only). Example shape:
# postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
CLASSLINK_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classlink

# Supabase project JWT secret (Project Settings > API). Verifies user tokens.
CLASSLINK_JWT_SECRET=change-me-supabase-jwt-secret

# Secret for the rotating BLE token HMAC. 32+ random bytes, server side only:
#   python -c "import secrets; print(secrets.token_hex(32))"
CLASSLINK_TOKEN_HMAC_SECRET=change-me-token-hmac-secret

# Comma separated emails that receive the teacher role at sign up.
CLASSLINK_TEACHER_EMAILS=["teacher@example.edu"]

# Optional: browser origins allowed to call the API.
CLASSLINK_CORS_ORIGINS=[]
